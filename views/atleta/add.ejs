<%- include('../cabecalho.ejs') %>

<h1>Cadastrar Atleta</h1>

<a href="/atleta/lst">
    Voltar para lista
</a>

<br><br>

<form
    action="/atleta/add"
    method="post"
    enctype="multipart/form-data"
>

    <label>Nome:</label>

    <input
        type="text"
        name="nome"
        required
    >

    <br><br>

    <label>Data de nascimento:</label>

    <input
        type="date"
        name="dataNasc"
        required
    >

    <br><br>

   <label>Equipe:</label>

<select name="equipe" required>

    <option value="">
        Selecione uma equipe
    </option>

    <option value="Gracie Bagé">
        Gracie Bagé
    </option>

    <option value="Nova União">
        Nova União
    </option>

    <option value="Alliance">
        Alliance
    </option>

    <option value="Checkmat">
        Checkmat
    </option>

    <option value="Outra">
        Outra
    </option>

</select>

    <br><br>

    <label>Foto:</label>

    <input
        type="file"
        name="foto"
        accept="image/*"
    >

    <br><br>

    <button type="submit">
        Cadastrar
    </button>

</form>

<%- include('../rodape.ejs') %>