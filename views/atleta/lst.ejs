<%- include('../cabecalho.ejs') %>

<h1>Atletas</h1>

<form action="/atleta/lst" method="post">

    <input
        type="text"
        name="filtro"
        placeholder="Pesquisar atleta"
    >

    <button type="submit">
        Pesquisar
    </button>

</form>

<br>

<a href="/atleta/add">
    + Novo Atleta
</a>

<br><br>

<table border="1">

    <tr>
        <th>Foto</th>
        <th>Nome</th>
        <th>Data de nascimento</th>
        <th>Equipe</th>
        <th>Ações</th>
    </tr>

    <% for (const atleta of Atletas) { %>

        <tr>

            <td>

                <% if (atleta.foto) { %>

                    <img
                        src="<%= atleta.foto %>"
                        width="100"
                        height="100"
                    >

                <% } else { %>

                    Sem foto

                <% } %>

            </td>

            <td>
                <%= atleta.nome %>
            </td>

            <td>
                <%= atleta.dataNasc.toISOString().split('T')[0] %>
            </td>

            <td>
                <%= atleta.equipe %>
            </td>

            <td>

                <a href="/atleta/edt/<%= atleta._id %>">
                    Editar
                </a>

                |

                <a href="/atleta/del/<%= atleta._id %>">
                    Excluir
                </a>

            </td>

        </tr>

    <% } %>

</table>

<%- include('../rodape.ejs') %>