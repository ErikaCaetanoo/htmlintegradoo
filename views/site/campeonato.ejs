<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= campeonato.nomeEve %> — Arena Jiu-Jitsu
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;0,900;1,800&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/site.css" />
</head>

<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/site"><span class="brand-mark"><span>JJ</span></span><span class="brand-name">ARENA
          <small>JIU-JITSU</small></span></a>
      <nav class="main-nav" aria-label="Navegação principal"><a href="/site">Início</a><a class="active"
          href="/site#campeonatos">Campeonatos</a><a href="/site/campeonato#atletas">Atletas</a></nav>
      <a class="header-action" href="/site/login"><svg aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21c.8-5 3.5-7 8-7s7.2 2 8 7" />
        </svg>Entrar</a>
    </div>
  </header>
  <main>
    <section class="details-hero"
      style="background-image:url('https://images.unsplash.com/photo-1747331796135-0e2354a712e4?auto=format&fit=crop&w=1800&q=90')">
      <div class="details-shade"></div>
      <div class="container details-content">
        <a class="back-link" href="/site">← VOLTAR AOS CAMPEONATOS</a>
        <div class="details-title-row">
          <div><span class="event-label"><i></i> INSCRIÇÕES ABERTAS</span>
            <h1>
              <%= campeonato.nomeEve %>
            </h1>
            <p>Prepare-se para competir neste campeonato.</p>
          </div>
          <a class="button-primary hero-action" href="/site/inscricao?campeonato=<%= campeonato._id %>">INSCREVER-SE
            AGORA <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg></a>
        </div>
        <div class="event-facts">
          <div class="fact"><svg aria-hidden="true" viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="16" rx="2" />
              <path d="M16 3v4M8 3v4M3 10h18" />
            </svg><span>DATA<strong>
                <%= new Date(campeonato.dataEve).toLocaleDateString('pt-BR', { day: '2-digit' , month: 'long' ,
                  year: 'numeric' }) %>
              </strong></span></div>
          <div class="fact"><svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg><span>LOCAL<strong>
                <%= campeonato.cidade %>
              </strong></span></div>
          <div class="fact"><svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M12 3 4.5 6v5.7c0 4.3 3 7.3 7.5 9.3 4.5-2 7.5-5 7.5-9.3V6L12 3Z" />
            </svg><span>ORGANIZAÇÃO<strong>
                <%= campeonato.organizador %>
              </strong></span></div>
          <div class="fact"><svg aria-hidden="true" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 2" />
            </svg><span>PRAZO<strong>até 18 de maio</strong></span></div>
        </div>
      </div>
    </section>
    <section class="details-main">
      <div class="container">
        <div class="section-heading">
          <div><span class="kicker">DIVISÕES DISPONÍVEIS</span>
            <h2>CATEGORIAS</h2>
          </div><a class="button-outline" href="/site/inscricao">VER TODAS AS CATEGORIAS</a>
        </div>
        <div class="category-list">
          <a class="category-row selected" href="#atletas"><i
              class="belt-color"></i><span><small>FAIXA</small><strong>Branca</strong></span><span><small>PESO</small><strong>Leve
                — até 76kg</strong></span><span><small>ANO / IDADE</small><strong>Adulto • 2007 ou
                anterior</strong></span><span class="athlete-total"><strong>18</strong><small>ATLETAS</small></span><svg
              aria-hidden="true" viewBox="0 0 24 24">
              <path d="m9 18 6-6-6-6" />
            </svg></a>
          <a class="category-row" href="#atletas"><i
              class="belt-color belt-blue"></i><span><small>FAIXA</small><strong>Azul</strong></span><span><small>PESO</small><strong>Médio
                — até 82,3kg</strong></span><span><small>ANO / IDADE</small><strong>Adulto • 2007 ou
                anterior</strong></span><span class="athlete-total"><strong>24</strong><small>ATLETAS</small></span><svg
              aria-hidden="true" viewBox="0 0 24 24">
              <path d="m9 18 6-6-6-6" />
            </svg></a>
          <a class="category-row" href="#atletas"><i
              class="belt-color belt-purple"></i><span><small>FAIXA</small><strong>Roxa</strong></span><span><small>PESO</small><strong>Meio-pesado
                — até 88,3kg</strong></span><span><small>ANO / IDADE</small><strong>Adulto • 2007 ou
                anterior</strong></span><span class="athlete-total"><strong>12</strong><small>ATLETAS</small></span><svg
              aria-hidden="true" viewBox="0 0 24 24">
              <path d="m9 18 6-6-6-6" />
            </svg></a>
        </div>
        <div class="section-heading athletes-heading" id="atletas">
          <div><span class="kicker">INSCRIÇÕES NO CAMPEONATO</span>
            <h2>ATLETAS INSCRITOS</h2>
          </div><span class="selected-category">
            <%= campeonato.atletas.length %> ATLETAS
          </span>
        </div>
        <div class="athletes-table-wrap">
          <table class="athletes-table">
            <thead>
              <tr>
                <th>ATLETA</th>
                <th>EQUIPE</th>
                <th>CATEGORIA</th>
                <th>STATUS DA INSCRIÇÃO</th>
              </tr>
            </thead>
            <tbody>
              <% campeonato.atletas.forEach(atleta=> { %>
                <tr>
                  <td><span class="athlete-avatar initials">
                      <%= atleta.nome.split(/\s+/).slice(0, 2).map(parte=> parte[0]).join('').toUpperCase() %>
                    </span><strong>
                      <%= atleta.nome %>
                    </strong></td>
                  <td>
                    <%= atleta.equipe %>
                  </td>
                  <td>
                    <%= atleta.categoria || 'Não informada' %>
                  </td>
                  <td><span class="status-badge pending"><i></i>Inscrito</span></td>
                </tr>
                <% }); %>
                  <% if (campeonato.atletas.length===0) { %>
                    <tr>
                      <td colspan="4">Ainda não há atletas inscritos neste campeonato.</td>
                    </tr>
                    <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="container footer-inner"><a class="brand" href="/site"><span
          class="brand-mark"><span>JJ</span></span><span class="brand-name">ARENA <small>JIU-JITSU</small></span></a>
      <p>O tatame conecta. A competição transforma.</p><span>© 2025 Arena Jiu-Jitsu</span>
    </div>
  </footer>
</body>

</html>