<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Campeonatos de Jiu-Jitsu em todo o Brasil." />
  <title>Campeonatos — Arena Jiu-Jitsu</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;0,900;1,800&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/site.css" />
</head>

<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/site" aria-label="Arena Jiu-Jitsu — início">
        <span class="brand-mark"><span>JJ</span></span>
        <span class="brand-name">ARENA <small>JIU-JITSU</small></span>
      </a>
      <nav class="main-nav" aria-label="Navegação principal">
        <a class="active" href="/site">Início</a>
        <a href="/site#campeonatos">Campeonatos</a>
        <a href="/site/campeonato#atletas">Atletas</a>
      </nav>
      <a class="header-action" href="/site/login">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21c.8-5 3.5-7 8-7s7.2 2 8 7" />
        </svg>
        Entrar
      </a>
    </div>
  </header>

  <main>
    <section class="home-hero">
      <div class="hero-photo"></div>
      <div class="hero-shade"></div>
      <div class="container hero-content">
        <span class="eyebrow"><i></i> O TATAME TE ESPERA</span>
        <h1>ENCONTRE SEU<br /><em>PRÓXIMO DESAFIO.</em></h1>
        <p>Os melhores campeonatos de Jiu-Jitsu do Brasil, em um só lugar.</p>
        <form class="search-panel" action="/site#campeonatos" method="get">
          <label class="search-control search-control-wide">
            <span>BUSCAR CAMPEONATO</span>
            <div><svg aria-hidden="true" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-4-4" />
              </svg><input type="search" name="busca" placeholder="Nome ou organizador" /></div>
          </label>
          <label class="search-control">
            <span>CIDADE</span>
            <div><svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg><select name="cidade">
                <option value="">Todas as cidades</option>
                <option>São Paulo</option>
                <option>Rio de Janeiro</option>
                <option>Curitiba</option>
              </select></div>
          </label>
          <label class="search-control">
            <span>DATA</span>
            <div><svg aria-hidden="true" viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="16" rx="2" />
                <path d="M16 3v4M8 3v4M3 10h18" />
              </svg><select name="mes">
                <option value="">Qualquer data</option>
                <option>Maio</option>
                <option>Junho</option>
                <option>Julho</option>
              </select></div>
          </label>
          <button class="button-primary search-button" type="submit" aria-label="Buscar"><svg aria-hidden="true"
              viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg></button>
        </form>
      </div>
    </section>

    <section class="events-section" id="campeonatos">
      <div class="container">
        <div class="section-heading">
          <div><span class="kicker">CALENDÁRIO DE EVENTOS</span>
            <h2>PRÓXIMOS CAMPEONATOS</h2>
          </div>
          <span class="result-count">
            <%= campeonatos.length %> CAMPEONATO<%= campeonatos.length===1 ? '' : 'S' %>
          </span>
        </div>
        <% if (campeonatos.length===0) { %>
          <p class="static-filter-note">Nenhum campeonato cadastrado no momento.</p>
          <% } else { %>
            <% const
              imagens=[ 'https://images.unsplash.com/photo-1747331796135-0e2354a712e4?auto=format&fit=crop&w=900&q=85'
              , 'https://images.unsplash.com/photo-1656653121475-e33829581294?auto=format&fit=crop&w=900&q=85'
              , 'https://images.unsplash.com/photo-1602827114685-efbb2717da9f?auto=format&fit=crop&w=900&q=85' ]; %>
              <div class="event-grid">
                <% campeonatos.forEach((campeonato, index)=> {
                  const dataEvento = new Date(campeonato.dataEve);
                  %>
                  <article class="event-card">
                    <a class="event-image" href="/site/campeonato/<%= campeonato._id %>"
                      style="background-image:url('<%= imagens[index % imagens.length] %>')">
                      <span class="availability"><i></i> EVENTO CADASTRADO</span>
                      <span class="date-tile"><strong>
                          <%= dataEvento.toLocaleDateString('pt-BR', { day: '2-digit' }) %>
                        </strong><small>
                          <%= dataEvento.toLocaleDateString('pt-BR', { month: 'short' }).replace('.', '' ).toUpperCase()
                            %>
                        </small></span>
                    </a>
                    <div class="event-body">
                      <h3>
                        <%= campeonato.nomeEve %>
                      </h3>
                      <p class="meta-line"><svg aria-hidden="true" viewBox="0 0 24 24">
                          <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                          <circle cx="12" cy="10" r="2.5" />
                        </svg>
                        <%= campeonato.cidade %>
                      </p>
                      <p class="meta-line"><svg aria-hidden="true" viewBox="0 0 24 24">
                          <rect x="3" y="5" width="18" height="16" rx="2" />
                          <path d="M16 3v4M8 3v4M3 10h18" />
                        </svg>
                        <%= dataEvento.toLocaleDateString('pt-BR', { day: '2-digit' , month: 'long' , year: 'numeric' })
                          %>
                      </p>
                      <div class="organizer"><span>ORGANIZAÇÃO</span><strong>
                          <%= campeonato.organizador %>
                        </strong></div>
                      <a class="card-button" href="/site/inscricao?campeonato=<%= campeonato._id %>">INSCREVER-SE <svg
                          aria-hidden="true" viewBox="0 0 24 24">
                          <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg></a>
                    </div>
                  </article>
                  <% }); %>
              </div>
              <% } %>
                <p class="static-filter-note">Nesta versão somente HTML/CSS, os filtros são visuais e serão conectados
                  ao backend durante a integração.</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <a class="brand" href="/site"><span class="brand-mark"><span>JJ</span></span><span class="brand-name">ARENA
          <small>JIU-JITSU</small></span></a>
      <p>O tatame conecta. A competição transforma.</p><span>© 2025 Arena Jiu-Jitsu</span>
    </div>
  </footer>
</body>

</html>